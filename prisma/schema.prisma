generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  productId   String   @db.Uuid
  rating      Int
  title       String
  description String
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_productId_product_id_fk")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_userId_user_id_fk")

  @@unique([productId, userId], map: "reviews_productId_userId_key")
}

// Starred products per user
model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_userId_user_id_fk")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_productId_product_id_fk")

  @@unique([userId, productId], map: "favorites_userId_productId_key")
}

// Hierarchical product categories: main -> sub -> (optional) sub-sub
model Category {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String     @unique(map: "category_slug_idx")
  name           String
  nameFa         String
  icon           String     @default("package")
  sortOrder      Int        @default(0)
  parentId       String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamp(6)
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "category_parentId_category_id_fk")
  children       Category[] @relation("CategoryTree")
  mainProducts   Product[]  @relation("ProductMainCategory")
  subProducts    Product[]  @relation("ProductSubCategory")
  subSubProducts Product[]  @relation("ProductSubSubCategory")
}

model Product {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  nameFa            String
  slug              String      @unique(map: "product_slug_idx")
  category          String
  categoryFa        String
  categoryId        String?     @db.Uuid
  subCategoryId     String?     @db.Uuid
  subSubCategoryId  String?     @db.Uuid
  images            String[]
  brand             String
  description       String
  descriptionFa     String
  stock             Int
  price             Decimal     @default(0) @db.Decimal(12, 2)
  compareAtPrice    Decimal?    @db.Decimal(12, 2)
  rating            Decimal     @default(0) @db.Decimal(3, 2)
  numReviews        Int         @default(0)
  isFeatured        Boolean     @default(false)
  banner            String?
  codAvailable      Boolean     @default(false)
  lengthCm          Decimal?    @db.Decimal(8, 2)
  widthCm           Decimal?    @db.Decimal(8, 2)
  heightCm          Decimal?    @db.Decimal(8, 2)
  weightG           Decimal?    @db.Decimal(10, 2)
  createdAt         DateTime    @default(now()) @db.Timestamp(6)
  categoryRef       Category?   @relation("ProductMainCategory", fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "product_categoryId_category_id_fk")
  subCategoryRef    Category?   @relation("ProductSubCategory", fields: [subCategoryId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "product_subCategoryId_category_id_fk")
  subSubCategoryRef Category?   @relation("ProductSubSubCategory", fields: [subSubCategoryId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "product_subSubCategoryId_category_id_fk")
  orderItems       OrderItem[]
  reviews          Review[]
  favorites        Favorite[]
  options          ProductOption[]
  variants         ProductVariant[]
}

// Product diversity: an option (e.g. color) with its selectable values
model ProductOption {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String               @db.Uuid
  name      String
  nameFa    String
  sortOrder Int                  @default(0)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productOptions_productId_product_id_fk")
  values    ProductOptionValue[]

  @@unique([productId, name], map: "productOptions_productId_name_key")
  @@index([productId], map: "productOptions_productId_idx")
}

model ProductOptionValue {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId  String        @db.Uuid
  value     String
  valueFa   String
  // Color swatch hex (color options only), e.g. #D32F2F
  hex       String?
  sortOrder Int           @default(0)
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productOptionValues_optionId_productOption_id_fk")

  @@unique([optionId, value], map: "productOptionValues_optionId_value_key")
}

// A purchasable combination of option values with its own price/stock
model ProductVariant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @db.Uuid
  // Deterministic combo signature (sorted valueIds joined ':') — uniqueness
  // + O(1) lookup from cart/checkout
  key            String   @unique(map: "productVariant_key_key")
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  // Display snapshot [{optionFa, valueFa, hex?}] — cart/orders need no joins
  options        Json
  image          String?
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productVariants_productId_product_id_fk")
  orderItems     OrderItem[]

  @@index([productId], map: "productVariants_productId_idx")
}

model Cart {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @db.Uuid
  sessionCartId  String
  items          Json[]   @default([])
  itemsPrice     Decimal  @db.Decimal(12, 2)
  shippingPrice  Decimal  @db.Decimal(12, 2)
  taxPrice       Decimal  @db.Decimal(12, 2)
  totalPrice     Decimal  @db.Decimal(12, 2)
  couponCode     String?
  couponDiscount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_userId_user_id_fk")
}

model Order {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @db.Uuid
  shippingAddress  Json        @db.Json
  paymentMethod    String
  paymentAuthority String?
  paymentResult    Json?
  itemsPrice       Decimal     @db.Decimal(12, 2)
  shippingPrice    Decimal     @db.Decimal(12, 2)
  taxPrice         Decimal     @db.Decimal(12, 2)
  totalPrice       Decimal     @db.Decimal(12, 2)
  couponCode       String?
  couponDiscount   Decimal     @default(0) @db.Decimal(12, 2)
  isPaid           Boolean     @default(false)
  paidAt           DateTime?   @db.Timestamp(6)
  isDelivered      Boolean     @default(false)
  deliveredAt      DateTime?   @db.Timestamp(6)
  createdAt        DateTime    @default(now()) @db.Timestamp(6)
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_userId_user_id_fk")
  orderItems       OrderItem[]
}

model OrderItem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String          @db.Uuid
  productId    String          @db.Uuid
  variantId    String?         @db.Uuid
  // Denormalized variant summary shown on order pages ("رنگ: آبی / طرح: گل")
  variantLabel String?
  qty          Int
  price        Decimal         @db.Decimal(12, 2)
  name         String
  slug         String
  image        String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderItems_orderId_order_id_fk")
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderItems_productId_product_id_fk")
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "orderItems_variantId_productVariant_id_fk")

  @@index([orderId], map: "orderItems_orderId_idx")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("NO_NAME")
  email         String?   @unique(map: "user_email_idx")
  password      String?
  role          String    @default("user")
  mobile        String?   @unique(map: "user_mobile_idx")
  nationalId    String?
  cardNumber    String?
  sheba         String?
  birthDate     DateTime? @db.Timestamp(6)
  emailVerified DateTime? @db.Timestamp(6)
  image         String?
  paymentMethod String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt
  account       Account[]
  session       Session[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  addresses     Address[]
  favorites     Favorite[]
}

// Saved shipping addresses; exactly one per user is the default
model Address {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  isDefault     Boolean  @default(false)
  fullName      String
  streetAddress String
  city          String
  province      String
  postalCode    String
  phone         String
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "address_userId_user_id_fk")

  @@index([userId], map: "address_userId_idx")
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_userId_user_id_fk")

  @@id([provider, providerAccountId], map: "account_provider_providerAccountId_pk")
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_userId_user_id_fk")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Global site settings (e.g. the site-wide display language)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Admin-editable homepage content blocks (hero, deal, sections, ...)
model HomeBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  enabled   Boolean  @default(true)
  data      Json
  updatedAt DateTime @updatedAt
}

// Discount coupons applied to the cart at checkout (admin-managed)
model Coupon {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique
  // 'percent' (1–99) or 'fixed' (Toman amount off)
  type        String    @default("percent")
  value       Decimal   @db.Decimal(12, 2)
  // Minimum cart subtotal (itemsPrice) required to apply; 0 = none
  minCartTotal Decimal  @default(0) @db.Decimal(12, 2)
  expiresAt   DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
}
